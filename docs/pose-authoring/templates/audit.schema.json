{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pose candidate audit handoff",
  "description": "Interchange shape for the audit template. The authoring store also checks the registered version fingerprint, independent reviewer and required completed checks before accepting a passed audit.",
  "type": "object",
  "required": ["versionId", "fingerprint", "status", "reviewer", "checks", "findings"],
  "properties": {
    "versionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["not-recorded", "passed", "needs-changes"] },
    "reviewer": { "type": "string", "minLength": 1, "maxLength": 150 },
    "reviewedAt": { "type": "string" },
    "references": { "type": "array", "items": { "type": "object", "required": ["label"], "properties": { "label": { "type": "string" }, "url": { "type": "string" }, "privateFile": { "type": "string" }, "sha256": { "type": "string" }, "reviewedAt": { "type": "string" }, "factsChecked": { "type": "array", "items": { "type": "string" } }, "variationMatch": { "enum": ["match", "partial", "mismatch", "not-checked"] }, "limitations": { "type": "string" } } } },
    "checks": { "type": "array", "maxItems": 50, "items": { "type": "object", "required": ["id", "label", "result"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120 }, "label": { "type": "string", "maxLength": 300 }, "result": { "enum": ["pass", "fail", "not-checked"] }, "note": { "type": "string", "maxLength": 12000 } } } },
    "findings": { "type": "array", "maxItems": 100, "items": { "type": "object", "required": ["severity", "text"], "properties": { "severity": { "enum": ["info", "warning", "error"] }, "text": { "type": "string", "maxLength": 12000 } } } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
